# Browser Supabase project (publishable key only — safe to expose)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_SUPABASE_PROJECT_ID=your-project-id

# Server-side Supabase (the publishable key is used for auth-aware reads)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_PROJECT_ID=your-project-id

# Server-only privileged key. Required for verified ledger writes.
# Never prefix this with VITE_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me

# Optional: default merchant wallet used by the live expense payment dialog.
# Defaults to the built-in Mezo Testnet demo merchant when unset.
# VITE_DEMO_MERCHANT_ADDRESS=0x0000000000000000000000000000000000000000

# Optional: database URL for drizzle-kit migrations (not used at runtime).
# LOVABLE_DB_MIGRATION_URL=postgresql://postgres:password@host:5432/postgres
